{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${command:cmake.buildDirectory}",
                "--"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "pack: elf -> bin",
            "type": "shell",
            "dependsOn": "cmake: build",
            "dependsOrder": "sequence",
            "command": "arm-none-eabi-objcopy",
            "args": [
                "-O",
                "binary",
                "${command:cmake.buildDirectory}/NYUSH_Infantry.elf",
                "${command:cmake.buildDirectory}/NYUSH_Infantry.bin"
            ],
            "problemMatcher": []
        },
        {
            "label": "flash: dfu-util",
            "type": "shell",
            "dependsOn": "pack: elf -> bin",
            "dependsOrder": "sequence",
            "command": "dfu-util",
            "args": [
                "-a",
                "0",
                "-s",
                "0x08000000:leave",
                "-D",
                "${command:cmake.buildDirectory}/NYUSH_Infantry.bin"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "flash: openocd (stlink)",
            "type": "shell",
            "dependsOn": "cmake: build",
            "dependsOrder": "sequence",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "init; reset init; program ${command:cmake.buildDirectory}/NYUSH_Infantry.elf verify reset exit"
            ],
            "problemMatcher": []
        }
    ]
}