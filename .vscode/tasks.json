{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${command:cmake.buildDirectory}",
                "--"
            ],
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "flash: openocd",
            "type": "shell",
            "dependsOn": "cmake: build",
            "dependsOrder": "sequence",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "init; reset init; program ${command:cmake.buildDirectory}/NYUSH_Infantry.elf verify reset exit"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}